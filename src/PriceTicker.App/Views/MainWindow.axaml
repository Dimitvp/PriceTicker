<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PriceTicker.App.ViewModels"
        xmlns:controls="using:PriceTicker.App.Controls"
        x:Class="PriceTicker.App.Views.MainWindow"
        x:DataType="vm:TickerViewModel"
        Title="PriceTicker"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        ShowInTaskbar="False"
        Icon="/Assets/priceticker.ico"
        WindowStartupLocation="Manual">

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.price">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.change">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="TextBlock.change.up">
      <Setter Property="Foreground" Value="#4ADE80" />
    </Style>
    <Style Selector="TextBlock.change.down">
      <Setter Property="Foreground" Value="#F87171" />
    </Style>
    <!-- While a chart is hovered the change column shows that point's date, in neutral grey. -->
    <Style Selector="TextBlock.change.hovering">
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="controls|Sparkline">
      <Setter Property="Stroke" Value="#A3A3A3" />
    </Style>
    <Style Selector="controls|Sparkline.up">
      <Setter Property="Stroke" Value="#4ADE80" />
    </Style>
    <Style Selector="controls|Sparkline.down">
      <Setter Property="Stroke" Value="#F87171" />
    </Style>
    <Style Selector="Grid.stale">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.footer">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>

    <!-- Range selector: a row of small pill buttons. -->
    <Style Selector="ListBox.ranges">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A3A3C" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C2C2E" />
    </Style>
    <!-- Declared last so hovering the selected range keeps it visibly selected. -->
    <Style Selector="ListBox.ranges ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A3A3C" />
    </Style>
  </Window.Styles>

  <Border Background="#E61C1C1E"
          CornerRadius="12"
          Padding="18,12"
          PointerPressed="OnDragAreaPressed">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Refresh now" Command="{Binding RefreshCommand}" />
        <MenuItem Header="Hide to tray" Click="OnHideClicked" />
        <MenuItem Header="Always on top" ToggleType="CheckBox" IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
        <MenuItem Header="Start with Windows" ToggleType="CheckBox"
                  IsChecked="{Binding StartsWithWindows, Mode=TwoWay}"
                  IsVisible="{Binding IsAutoStartSupported}" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClicked" />
      </ContextMenu>
    </Border.ContextMenu>

    <StackPanel Spacing="8">
      <ListBox Classes="ranges"
               HorizontalAlignment="Right"
               ItemsSource="{x:Static vm:TickerViewModel.Ranges}"
               SelectedItem="{Binding SelectedRange, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ChartRangeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <ItemsControl ItemsSource="{Binding Items}" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuoteItemViewModel">
            <Grid Margin="0,4" Classes.stale="{Binding IsStale}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Price" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{Binding DisplayName}" Margin="0,0,18,0"
                         ToolTip.Tip="{Binding Detail}" />
              <controls:Sparkline Grid.Column="1" Height="36"
                                  Values="{Binding ChartValues}"
                                  HoveredIndex="{Binding HoveredIndex, Mode=OneWayToSource}"
                                  Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                  ToolTip.Tip="{Binding ChartStatus}" />
              <!-- Invisible: reserves the widest price so hovering never resizes the window. -->
              <TextBlock Grid.Column="2" Classes="price" Margin="18,0,0,0" Opacity="0" IsHitTestVisible="False"
                         Text="{Binding WidestPriceText}" />
              <TextBlock Grid.Column="2" Classes="price" Margin="18,0,0,0"
                         Text="{Binding ShownPriceText}" ToolTip.Tip="{Binding Detail}" />
              <!-- MinWidth fits a hovered date ("22.11.2026"), so hovering never resizes the window. -->
              <TextBlock Grid.Column="3" Classes="change" Margin="16,0,0,0" MinWidth="88" TextAlignment="Right"
                         Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                         Classes.hovering="{Binding IsHovering}"
                         Text="{Binding ShownChangeText}" ToolTip.Tip="{Binding ChangeDescription}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Classes="footer" Text="{Binding LastUpdatedText}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
