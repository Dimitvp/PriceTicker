<Project>
  <!--
    The one way to build the exe: dotnet publish src/PriceTicker.App -c Release -p:PublishProfile=win-x64
    IncludeNativeLibrariesForSelfExtract puts Skia and HarfBuzz inside the exe; without it the exe
    dies on start, before it can draw a window, unless their DLLs sit next to it.
  -->
  <PropertyGroup>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)/../../publish/</PublishDir>
  </PropertyGroup>
</Project>
