<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PriceTicker.App.ViewModels"
        xmlns:controls="using:PriceTicker.App.Controls"
        x:Class="PriceTicker.App.Views.MainWindow"
        x:DataType="vm:TickerViewModel"
        Title="PriceTicker"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="{Binding IsAlwaysOnTop}"
        ShowInTaskbar="False"
        Icon="/Assets/priceticker.ico"
        WindowStartupLocation="Manual">

  <!--
    Colour-blind-safe palette (Okabe–Ito). Up/down are blue/orange instead of green/red; the review
    alert is a clear yellow and the sell alert a reddish purple, which stay distinct for red–green
    colour blindness. Alerts also carry a text badge, so nothing depends on colour alone.
  -->
  <Window.Resources>
    <SolidColorBrush x:Key="UpBrush" Color="#56B4E9" />
    <SolidColorBrush x:Key="DownBrush" Color="#E69F00" />
    <SolidColorBrush x:Key="ReviewBrush" Color="#F0E442" />
    <SolidColorBrush x:Key="SellBrush" Color="#CC79A7" />
    <!-- Light red for a position worth less than was put in. Not Okabe–Ito: chosen to stay apart from
         the orange "down" and the yellow review colour for deuteranopia, with 4.8:1 contrast on the panel. -->
    <SolidColorBrush x:Key="LossBrush" Color="#FF5A5A" />
    <SolidColorBrush x:Key="ReviewTintBrush" Color="#F0E442" Opacity="0.18" />
    <SolidColorBrush x:Key="SellTintBrush" Color="#CC79A7" Opacity="0.24" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.price">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.change">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="TextBlock.change.up">
      <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
    </Style>
    <Style Selector="TextBlock.change.down">
      <Setter Property="Foreground" Value="{StaticResource DownBrush}" />
    </Style>
    <!-- While a chart is hovered the change column shows that point's date, in neutral grey. -->
    <Style Selector="TextBlock.change.hovering">
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="controls|Sparkline">
      <Setter Property="Stroke" Value="#A3A3A3" />
    </Style>
    <Style Selector="controls|Sparkline.up">
      <Setter Property="Stroke" Value="{StaticResource UpBrush}" />
    </Style>
    <Style Selector="controls|Sparkline.down">
      <Setter Property="Stroke" Value="{StaticResource DownBrush}" />
    </Style>
    <Style Selector="Grid.stale">
      <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Position columns (Ticker:Holdings with Quantity and Invested). -->
    <Style Selector="TextBlock.position">
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.position.up">
      <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
    </Style>
    <Style Selector="TextBlock.position.down">
      <Setter Property="Foreground" Value="{StaticResource DownBrush}" />
    </Style>
    <Style Selector="TextBlock.column-heading">
      <Setter Property="Margin" Value="20,0,0,0" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8E8E93" />
    </Style>

    <!-- Value now below the money put in. -->
    <Style Selector="TextBlock.position.value.loss">
      <Setter Property="Foreground" Value="{StaticResource LossBrush}" />
    </Style>

    <!-- Headed groups (Ticker:Groups) sit on a faint panel; the trailing ungrouped rows do not. -->
    <Style Selector="Border.group.headed">
      <Setter Property="Background" Value="#0FFFFFFF" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="4,6,4,4" />
    </Style>
    <Style Selector="StackPanel.group-heading">
      <Setter Property="Margin" Value="12,0,0,4" />
    </Style>
    <Style Selector="TextBlock.group-title">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="#D8D8DC" />
    </Style>
    <Style Selector="TextBlock.group-note">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8E8E93" />
    </Style>

    <!-- Rows of held instruments: yellow at the review alert, reddish purple at a sell alert. -->
    <Style Selector="Border.row">
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.row.review">
      <Setter Property="Background" Value="{StaticResource ReviewTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource ReviewBrush}" />
    </Style>
    <Style Selector="Border.row.sell">
      <Setter Property="Background" Value="{StaticResource SellTintBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource SellBrush}" />
    </Style>
    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.badge.review">
      <Setter Property="Background" Value="{StaticResource ReviewBrush}" />
    </Style>
    <Style Selector="Border.badge.sell">
      <Setter Property="Background" Value="{StaticResource SellBrush}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="TextBlock.market">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A8A8A" />
      <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.market.open">
      <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
    </Style>
    <Style Selector="TextBlock.holding">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>

    <!-- Gold bar panel. -->
    <Style Selector="TextBlock.muted">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#9A9A9A" />
    </Style>
    <Style Selector="TextBlock.buyback.reached">
      <Setter Property="Foreground" Value="{StaticResource UpBrush}" />
    </Style>
    <Style Selector="Grid.dealer.stale">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="TextBlock.footer">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8A8A8A" />
    </Style>

    <!-- Range selector: a row of small pill buttons. -->
    <Style Selector="ListBox.ranges">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#A3A3A3" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:selected TextBlock">
      <Setter Property="Foreground" Value="#F2F2F2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A3A3C" />
    </Style>
    <Style Selector="ListBox.ranges ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2C2C2E" />
    </Style>
    <!-- Declared last so hovering the selected range keeps it visibly selected. -->
    <Style Selector="ListBox.ranges ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3A3A3C" />
    </Style>
  </Window.Styles>

  <Border Background="#E61C1C1E"
          CornerRadius="12"
          Padding="18,12"
          PointerPressed="OnDragAreaPressed">
    <Border.ContextMenu>
      <ContextMenu>
        <MenuItem Header="Refresh now" Command="{Binding RefreshCommand}" />
        <MenuItem Header="Hide to tray" Click="OnHideClicked" />
        <MenuItem Header="Always on top" ToggleType="CheckBox" IsChecked="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
        <MenuItem Header="Start with Windows" ToggleType="CheckBox"
                  IsChecked="{Binding StartsWithWindows, Mode=TwoWay}"
                  IsVisible="{Binding IsAutoStartSupported}" />
        <Separator />
        <MenuItem Header="Exit" Click="OnExitClicked" />
      </ContextMenu>
    </Border.ContextMenu>

    <StackPanel Spacing="8">
      <ListBox Classes="ranges"
               HorizontalAlignment="Right"
               ItemsSource="{x:Static vm:TickerViewModel.Ranges}"
               SelectedItem="{Binding SelectedRange, Mode=TwoWay}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="2" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ChartRangeOption">
            <TextBlock Text="{Binding Label}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- One shared size scope over the headings and all groups keeps the columns aligned. -->
      <StackPanel Spacing="2" Grid.IsSharedSizeScope="True">
      <!-- Margin: group padding (4) + the row's alert border (4) and padding (8) on the left; 4 + 8 on the right. -->
      <Grid Margin="16,0,12,0" IsVisible="{Binding ShowsPositions}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
          <ColumnDefinition Width="180" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Price" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Invested" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="Gain" />
          <ColumnDefinition Width="Auto" SharedSizeGroup="HeldSince" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="4" Classes="column-heading" Text="Invested"
                   ToolTip.Tip="Money put in so far, commissions included (EUR)" />
        <TextBlock Grid.Column="5" Classes="column-heading" Text="Value now"
                   ToolTip.Tip="What selling the whole position at this price would bring, before the sale's costs (EUR)" />
        <TextBlock Grid.Column="6" Classes="column-heading" Text="Gain"
                   ToolTip.Tip="The whole position against the money put in" />
        <TextBlock Grid.Column="7" Classes="column-heading" Text="Held since"
                   ToolTip.Tip="First purchase, and how long ago it was" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Groups}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:QuoteGroupViewModel">
            <Border Classes="group" Classes.headed="{Binding HasHeading}">
              <StackPanel>
                <StackPanel Classes="group-heading" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasHeading}">
                  <TextBlock Classes="group-title" Text="{Binding Title}" />
                  <TextBlock Classes="group-note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                </StackPanel>
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuoteItemViewModel">
                    <Border Classes="row" Margin="0,1"
                            Classes.review="{Binding IsReviewAlert}" Classes.sell="{Binding IsSellAlert}">
                    <Grid Classes.stale="{Binding IsStale}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Price" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Change" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Invested" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Value" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="Gain" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="HeldSince" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0" Margin="0,0,18,0" VerticalAlignment="Center"
                                  Background="Transparent" ToolTip.Tip="{Binding AlertDescription}">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding DisplayName}" />
                          <Border Classes="badge" Classes.review="{Binding IsReviewAlert}" Classes.sell="{Binding IsSellAlert}"
                                  IsVisible="{Binding AlertBadge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Text="{Binding AlertBadge}" />
                          </Border>
                        </StackPanel>
                        <TextBlock Classes="holding" Text="{Binding SubtitleText}"
                                   IsVisible="{Binding SubtitleText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <controls:Sparkline Grid.Column="1" Height="36"
                                          Values="{Binding ChartValues}"
                                          HoveredIndex="{Binding HoveredIndex, Mode=OneWayToSource}"
                                          Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                          ToolTip.Tip="{Binding ChartStatus}" />
                      <StackPanel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Panel>
                          <!-- Invisible: reserves the widest price so hovering never resizes the window. -->
                          <TextBlock Classes="price" Opacity="0" IsHitTestVisible="False" Text="{Binding WidestPriceText}" />
                          <TextBlock Classes="price" Text="{Binding ShownPriceText}" ToolTip.Tip="{Binding Detail}" />
                        </Panel>
                        <TextBlock Classes="market" Classes.open="{Binding IsMarketOpen}" Text="{Binding MarketText}"
                                   IsVisible="{Binding MarketText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                      <!-- MinWidth fits a hovered date ("22.11.2026"), so hovering never resizes the window. -->
                      <TextBlock Grid.Column="3" Classes="change" Margin="16,0,0,0" MinWidth="88" TextAlignment="Right"
                                 Classes.up="{Binding IsUp}" Classes.down="{Binding IsDown}"
                                 Classes.hovering="{Binding IsHovering}"
                                 Text="{Binding ShownChangeText}" ToolTip.Tip="{Binding ChangeDescription}" />
                      <!-- The position columns: empty for instruments without a configured position. -->
                      <TextBlock Grid.Column="4" Classes="position" Text="{Binding InvestedText}" />
                      <TextBlock Grid.Column="5" Classes="position value" Classes.loss="{Binding IsPositionDown}"
                                 Text="{Binding PositionValueText}" />
                      <TextBlock Grid.Column="6" Classes="position" MinWidth="72"
                                 Classes.up="{Binding IsPositionUp}" Classes.down="{Binding IsPositionDown}"
                                 Text="{Binding PositionGainText}" />
                      <StackPanel Grid.Column="7" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Right" Text="{Binding HeldSinceText}" />
                        <TextBlock Classes="market" HorizontalAlignment="Right" Text="{Binding HeldForText}"
                                   IsVisible="{Binding HeldForText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      </StackPanel>
                    </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      </StackPanel>

      <Border IsVisible="{Binding GoldBar.IsVisible}" Background="#14FFFFFF" CornerRadius="8"
              Padding="12,8" Margin="0,6,0,0">
        <StackPanel Spacing="6" DataContext="{Binding GoldBar}" x:DataType="vm:GoldBarViewModel"
                    Grid.IsSharedSizeScope="True">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="{Binding PurchaseText}" Margin="16,0,0,0" />
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" SharedSizeGroup="Dealer" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Buy" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="Buyback" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Classes="muted" Text="You buy" HorizontalAlignment="Right" Margin="24,0,0,0" />
            <TextBlock Grid.Column="2" Classes="muted" Text="You sell" HorizontalAlignment="Right" Margin="24,0,0,0" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Dealers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DealerRowViewModel">
                <Grid Classes="dealer" Classes.stale="{Binding IsStale}" Margin="0,1"
                      Background="Transparent" ToolTip.Tip="{Binding Detail}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" SharedSizeGroup="Dealer" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Buy" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="Buyback" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding Dealer}" />
                  <TextBlock Grid.Column="1" Text="{Binding BuyText}" HorizontalAlignment="Right" Margin="24,0,0,0" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                    <TextBlock Classes="price buyback" Classes.reached="{Binding IsTargetReached}"
                               Text="{Binding BuybackText}" />
                    <!-- A target reached is also marked with a tick, not only with colour. -->
                    <TextBlock Classes="buyback reached" Text=" ✓" FontWeight="Bold" IsVisible="{Binding IsTargetReached}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl ItemsSource="{Binding Targets}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Classes="muted" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Classes="footer" Text="{Binding LastUpdatedText}" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
